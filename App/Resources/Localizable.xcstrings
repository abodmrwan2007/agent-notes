    "All notebooks in the trash will be removed from this device. This cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف كل الدفاتر الموجودة في السلة من هذا الجهاز. لا يمكن التراجع عن ذلك."
          }
