    "Check the text: recognition can misread handwriting. Edit it here before putting it on the page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع النص: قد يخطئ التعرّف في قراءة خط اليد. عدّله هنا قبل وضعه في الصفحة."
          }
        }
