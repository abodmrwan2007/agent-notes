    "The 3D heart in Atlas is made from these models: parts selected, merged, reduced and coloured. The changed model is shared under the same license.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القلب ثلاثي الأبعاد في الأطلس مصنوع من هذه المجسّمات: اختيرت أجزاؤه ودُمجت وصُغّرت ولُوّنت، ويُشارك المجسّم المعدّل بالترخيص نفسه."
          }
        }
      }
    },
    "The AI declined this request.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الذكاء الاصطناعي هذا الطلب."
          }
        }
      }
    },
    "The AI service is busy right now. Try again in a minute.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة الذكاء الاصطناعي مشغولة الآن. حاول بعد دقيقة."
          }
        }
      }
    },
    "The API key was not accepted. Check it in Settings ▸ AI Assistant.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُقبل مفتاح API. راجعه في الإعدادات ◂ مساعد الذكاء الاصطناعي."
          }
        }
      }
    },
    "The answer could not be read. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة الإجابة. حاول مرة أخرى."
          }
        }
      }
    },
    "The answer was cut off because it was very long.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطعت الإجابة لأنها طويلة جدًا."
          }
        }
      }
    },
    "The audio is removed from this notebook. Your writing stays.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحذف الصوت من هذا الدفتر وتبقى كتابتك."
          }
        }
      }
    },
    "The background could not be removed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت إزالة الخلفية."
          }
        }
      }
    },
    "The brush button holds fountain pen, monoline, watercolor and crayon. The ruler button shows a ruler on the page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زر الفُرَش فيه قلم الحبر السائل والخط الموحّد والألوان المائية والشمع الملوّن. وزر المسطرة يُظهر مسطرة على الصفحة."
          }
        }
      }
    },
    "The expression is incomplete.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العبارة غير مكتملة."
          }
        }
      }
    },
    "The handwriting on one page could not be read. That page is shown read-only to protect the saved file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة الكتابة في إحدى الصفحات. تُعرض تلك الصفحة للقراءة فقط حمايةً للملف المحفوظ."
          }
        }
      }
    },
    "The heart model could not be loaded": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل مجسّم القلب"
          }
        }
      }
    },
    "The key could not be saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ المفتاح."
          }
        }
      }
    },
    "The key was removed from this iPad.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُزيل المفتاح من هذا الآيباد."
          }
        }
      }
    },
    "The notebook could not be saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ الدفتر."
          }
        }
      }
    },
    "The notebook could not be unlocked.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح قفل الدفتر."
          }
        }
      }
    },
    "The notes library could not be opened on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح مكتبة الملاحظات على هذا الجهاز."
          }
        }
      }
    },
    "The objects on this page could not be read, so they cannot be changed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة عناصر هذه الصفحة، لذلك لا يمكن تعديلها."
          }
        }
      }
    },
    "The page and its handwriting will be removed. This cannot be undone, and it clears the undo history.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف الصفحة وما فيها من كتابة. لا يمكن التراجع عن ذلك، وسيُمسح سجل التراجع."
          }
        }
      }
    },
    "The request was rejected (it may be too large: try one page).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رُفض الطلب (قد يكون كبيرًا: جرّب صفحة واحدة)."
          }
        }
      }
    },
    "The result is too large.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الناتج أكبر من أن يُعرض."
          }
        }
      }
    },
    "These pages are empty. Write or import something first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الصفحات فارغة. اكتب أو استورد شيئًا أولًا."
          }
        }
      }
    },
    "Thickness": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماكة"
          }
        }
      }
    },
    "This PDF has no pages.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف لا يحتوي على صفحات."
          }
        }
      }
    },
    "This character is not understood: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز غير مفهوم: %@"
          }
        }
      }
    },
    "This file could not be read as a PDF.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة هذا الملف كملف PDF."
          }
        }
      }
    },
    "This file is not a valid notebook package.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف ليس حزمة دفتر صالحة."
          }
        }
      }
    },
    "This notebook and its handwriting will be removed from this device. This cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف هذا الدفتر وما فيه من كتابة من هذا الجهاز. لا يمكن التراجع عن ذلك."
          }
        }
      }
    },
    "This notebook could not be opened": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح هذا الدفتر"
          }
        }
      }
    },
    "This page": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الصفحة"
          }
        }
      }
    },
    "This picture could not be read.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة هذه الصورة."
          }
        }
      }
    },
    "This recording could not be played.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تشغيل هذا التسجيل."
          }
        }
      }
    },
    "This was not written during a recording.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُكتب هذا أثناء تسجيل."
          }
        }
      }
    },
    "Time for a break.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حان وقت الاستراحة."
          }
        }
      }
    },
    "Time to focus again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حان وقت العودة إلى التركيز."
          }
        }
      }
    },
    "Tip: select text on a PDF page with the Select Text tool, then tap Explain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلميح: حدّد نصًا في صفحة PDF بأداة «تحديد النص» ثم اضغط «اشرح»."
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنوان"
          }
        }
      }
    },
    "To erase, scribble back and forth at least five times across the strokes. Undo brings them back.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للمسح، خربش ذهابًا وإيابًا خمس مرات على الأقل فوق الخطوط. التراجع يعيدها."
          }
        }
      }
    },
    "Too many requests, or your account's spending limit was reached. Wait a minute, or check your limits at console.anthropic.com.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبات كثيرة، أو وصل حسابك إلى حد الصرف. انتظر دقيقة، أو راجع حدودك في console.anthropic.com."
          }
        }
      }
    },
    "Tools": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأدوات"
          }
        }
      }
    },
    "Tools and Stickers": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأدوات والملصقات"
          }
        }
      }
    },
    "Tools beside your page": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأدوات بجانب صفحتك"
          }
        }
      }
    },
    "Tools ▸ AI: summarize a page or the notebook, make flashcards and a quiz, ask questions, or select PDF text and tap Explain. Add your Claude API key in Settings ▸ AI Assistant first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأدوات ◂ الذكاء الاصطناعي: لخّص صفحة أو الدفتر، واصنع بطاقات واختبارًا، واسأل، أو حدّد نصًا في PDF واضغط «اشرح». أضف مفتاح Claude API أولًا من الإعدادات ◂ مساعد الذكاء الاصطناعي."
          }
        }
      }
    },
    "Tools ▸ Stickers ▸ Labelled Diagrams: heart, lungs, brain, neuron, eye and cell, with English, Arabic or blank labels to test yourself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأدوات ◂ الملصقات ◂ رسوم توضيحية مُعنونة: القلب والرئتان والدماغ والخلية العصبية والعين والخلية، بتسميات إنجليزية أو عربية أو فارغة لتختبر نفسك."
          }
        }
      }
    },
    "Touch and hold a notebook and choose Favorite.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على دفتر واختر «مفضلة»."
          }
        }
      }
    },
    "Touch and hold a notebook in the library for Lock…, Cover and Tags…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على دفتر في المكتبة لتجد «قفل…» و«الغلاف» و«الوسوم…»."
          }
        }
      }
    },
    "Transition metal": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فلز انتقالي"
          }
        }
      }
    },
    "Translate": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجم"
          }
        }
      }
    },
    "Translate & Look Up": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمة وقاموس"
          }
        }
      }
    },
    "Translation Tool": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أداة الترجمة"
          }
        }
      }
    },
    "Trash": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سلة المحذوفات"
          }
        }
      }
    },
    "Trash is empty": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السلة فارغة"
          }
        }
      }
    },
    "Trigonometry, logarithms, powers and factorials, computed on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دوال مثلثية ولوغاريتمات وقوى ومضروب، تُحسب على هذا الجهاز."
          }
        }
      }
    },
    "Typed text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نص مكتوب"
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تراجع"
          }
        }
      }
    },
    "Unexpected symbol: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز في غير موضعه: %@"
          }
        }
      }
    },
    "Unknown name: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم غير معروف: %@"
          }
        }
      }
    },
    "Unlock": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح القفل"
          }
        }
      }
    },
    "Untitled notebook": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دفتر بلا عنوان"
          }
        }
      }
    },
    "Use x as the variable, for example x^2, 1/x or 2sin(x). Angles are in radians.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم x متغيرًا، مثل x^2 أو 1/x أو 2sin(x). الزوايا بالراديان."
          }
        }
      }
    },
    "Used today": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستخدم اليوم"
          }
        }
      }
    },
    "Used unmodified as medical and study stickers.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستخدمة دون تعديل كملصقات طبية ودراسية."
          }
        }
      }
    },
    "Valves and papillary muscles": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصمامات والعضلات الحليمية"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإصدار"
          }
        }
      }
    },
    "View": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العرض"
          }
        }
      }
    },
    "Warning": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنبيه"
          }
        }
      }
    },
    "Watercolor": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألوان مائية"
          }
        }
      }
    },
    "What's New": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجديد"
          }
        }
      }
    },
    "When off, only Apple Pencil draws and one finger scrolls. When on, one finger draws and two fingers scroll.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف يرسم قلم Apple Pencil فقط ويُمرَّر بإصبع واحد. عند التشغيل يرسم إصبع واحد ويُمرَّر بإصبعين."
          }
        }
      }
    },
    "Where Else?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أين ذُكر أيضًا؟"
          }
        }
      }
    },
    "Whole notebook": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدفتر كاملًا"
          }
        }
      }
    },
    "Whole stroke": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخط كاملًا"
          }
        }
      }
    },
    "Work and break sessions that keep counting in the background.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسات عمل واستراحة يستمر عدّها في الخلفية."
          }
        }
      }
    },
    "Workspace": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة العمل"
          }
        }
      }
    },
    "Write": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كتابة"
          }
        }
      }
    },
    "Writing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتابة"
          }
        }
      }
    },
    "Wrong number of values for %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد القيم غير صحيح للدالة %@."
          }
        }
      }
    },
    "You can open this again from Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك فتح هذه الشاشة مجددًا من الإعدادات."
          }
        }
      }
    },
    "You have used today's %lld AI requests. Change the daily limit in Settings ▸ AI Assistant.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدمت طلبات اليوم وعددها %lld. غيّر الحد اليومي من الإعدادات ◂ مساعد الذكاء الاصطناعي."
          }
        }
      }
    },
    "Your latest strokes could not be saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ آخر ما كتبته."
          }
        }
      }
    },
    "Your pages are sent to Anthropic (Claude) to answer. Check important medical facts against your textbook.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرسل صفحاتك إلى Anthropic ‏(Claude) للإجابة. راجع المعلومات الطبية المهمة في كتابك."
          }
        }
      }
    },
    "Zoom In": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكبير"
          }
        }
      }
    },
    "Zoom Out": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصغير"
          }
        }
      }
    },
    "copy": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخة"
          }
        }
      }
    }
  },
  "version": "1.0"
}
