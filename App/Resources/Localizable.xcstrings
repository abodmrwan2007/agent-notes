{
  "sourceLanguage": "en",
  "strings": {
    "%lld pages": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld صفحة"
          }
        }
      }
    },
    "3D data: BodyParts3D, © The Database Center for Life Science, licensed under CC Attribution-Share Alike 2.1 Japan. Reduced and coloured for this app. A study model, not reviewed by an anatomist. The muscle wall of both ventricles is one piece.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات ثلاثية الأبعاد: BodyParts3D، © The Database Center for Life Science، بترخيص CC Attribution-Share Alike 2.1 Japan. مُصغّرة وملوّنة لهذا التطبيق. مجسّم للدراسة لم يراجعه مختص تشريح. الجدار العضلي للبطينين قطعة واحدة."
          }
        }
      }
    },
    "3D heart atlas": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أطلس القلب ثلاثي الأبعاد"
          }
        }
      }
    },
    "A closing parenthesis is missing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينقص قوس إغلاق."
          }
        }
      }
    },
    "A key is saved on this iPad.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد مفتاح محفوظ على هذا الآيباد."
          }
        }
      }
    },
    "AI": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذكاء الاصطناعي"
          }
