    "Tags…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوسوم…"
          }
        }
      }
    },
    "Tap an object to select it. Use Insert to add text, notes, shapes and images.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على عنصر لتحديده. استخدم «إدراج» لإضافة نص وملاحظات وأشكال وصور."
          }
        }
      }
    },
    "Text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نص"
          }
        }
      }
    },
    "Text Box": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مربع نص"
          }
        }
      }
    },
    "The expression is incomplete.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العبارة غير مكتملة."
          }
        }
      }
    },
    "The handwriting on one page could not be read. That page is shown read-only to protect the saved file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة الكتابة في إحدى الصفحات. تُعرض تلك الصفحة للقراءة فقط حمايةً للملف المحفوظ."
          }
        }
      }
    },
    "The interactive anatomy atlas starts with a heart module. It needs reviewed 3D assets that do not exist yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ أطلس التشريح التفاعلي بوحدة القلب، ويحتاج إلى نماذج ثلاثية الأبعاد مُراجَعة غير متوفرة بعد."
          }
        }
      }
    },
    "The notebook could not be saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ الدفتر."
          }
        }
      }
    },
    "The notes library could not be opened on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح مكتبة الملاحظات على هذا الجهاز."
          }
        }
      }
    },
    "The objects on this page could not be read, so they cannot be changed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة عناصر هذه الصفحة، لذلك لا يمكن تعديلها."
          }
        }
      }
    },
    "The page and its handwriting will be removed. This cannot be undone, and it clears the undo history.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف الصفحة وما فيها من كتابة. لا يمكن التراجع عن ذلك، وسيُمسح سجل التراجع."
          }
        }
      }
    },
    "The result is too large.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الناتج أكبر من أن يُعرض."
          }
        }
      }
    },
    "Thickness": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماكة"
          }
        }
      }
    },
    "This PDF has no pages.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف لا يحتوي على صفحات."
          }
        }
      }
    },
    "This character is not understood: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز غير مفهوم: %@"
          }
        }
      }
    },
    "This file could not be read as a PDF.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة هذا الملف كملف PDF."
          }
        }
      }
    },
    "This file is not a valid notebook package.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف ليس حزمة دفتر صالحة."
          }
        }
      }
    },
    "This notebook and its handwriting will be removed from this device. This cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف هذا الدفتر وما فيه من كتابة من هذا الجهاز. لا يمكن التراجع عن ذلك."
          }
        }
      }
    },
    "This notebook could not be opened": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح هذا الدفتر"
          }
        }
      }
    },
    "This picture could not be read.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة هذه الصورة."
          }
        }
      }
    },
    "Time for a break.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حان وقت الاستراحة."
          }
        }
      }
    },
    "Time to focus again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حان وقت العودة إلى التركيز."
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنوان"
          }
        }
      }
    },
    "To erase, scribble back and forth at least five times across the strokes. Undo brings them back.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للمسح، خربش ذهابًا وإيابًا خمس مرات على الأقل فوق الخطوط. التراجع يعيدها."
          }
        }
      }
    },
    "Tools": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأدوات"
          }
        }
      }
    },
    "Touch and hold a notebook and choose Favorite.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على دفتر واختر «مفضلة»."
          }
        }
      }
    },
    "Transition metal": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فلز انتقالي"
          }
        }
      }
    },
    "Translation Tool": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أداة الترجمة"
          }
        }
      }
    },
    "Trash": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سلة المحذوفات"
          }
        }
      }
    },
    "Trash is empty": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السلة فارغة"
          }
        }
      }
    },
    "Trigonometry, logarithms, powers and factorials, computed on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دوال مثلثية ولوغاريتمات وقوى ومضروب، تُحسب على هذا الجهاز."
          }
        }
      }
    },
    "Typed text": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نص مكتوب"
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تراجع"
          }
        }
      }
    },
    "Unexpected symbol: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز في غير موضعه: %@"
          }
        }
      }
    },
    "Unknown name: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم غير معروف: %@"
          }
        }
      }
    },
    "Unlock": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح القفل"
          }
        }
      }
    },
    "Untitled notebook": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دفتر بلا عنوان"
          }
        }
      }
    },
    "Use x as the variable, for example x^2, 1/x or 2sin(x). Angles are in radians.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم x متغيرًا، مثل x^2 أو 1/x أو 2sin(x). الزوايا بالراديان."
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإصدار"
          }
        }
      }
    },
    "View": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العرض"
          }
        }
      }
    },
    "When off, only Apple Pencil draws and one finger scrolls. When on, one finger draws and two fingers scroll.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف يرسم قلم Apple Pencil فقط ويُمرَّر بإصبع واحد. عند التشغيل يرسم إصبع واحد ويُمرَّر بإصبعين."
          }
        }
      }
    },
    "Where Else?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أين ذُكر أيضًا؟"
          }
        }
      }
    },
    "Whole stroke": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخط كاملًا"
          }
        }
      }
    },
    "Work and break sessions that keep counting in the background.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسات عمل واستراحة يستمر عدّها في الخلفية."
          }
        }
      }
    },
    "Workspace": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة العمل"
          }
        }
      }
    },
    "Writing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتابة"
          }
        }
      }
    },
    "Wrong number of values for %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد القيم غير صحيح للدالة %@."
          }
        }
      }
    },
    "Your latest strokes could not be saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ آخر ما كتبته."
          }
        }
      }
    },
    "Zoom In": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكبير"
          }
        }
      }
    },
    "Zoom Out": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصغير"
          }
        }
      }
    },
    "copy": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخة"
          }
        }
      }
    }
  },
  "version": "1.0"
}
