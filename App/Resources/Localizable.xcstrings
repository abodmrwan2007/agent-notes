    "Add your Claude API key in Settings ▸ AI Assistant first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مفتاح Claude API أولًا من الإعدادات ◂ مساعد الذكاء الاصطناعي."
          }
        }
      }
    },
    "Add your own pictures to use them as stickers. Cut-outs with transparent backgrounds work best.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف صورك لتستخدمها ملصقات. الصور المقصوصة بخلفية شفافة تبدو أفضل."
          }
        }
      }
    },
    "Added": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُضيف"
          }
        }
      }
    },
